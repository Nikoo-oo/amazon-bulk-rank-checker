{
  "manifest_version": 3,
  "name": "亚马逊批量查排名",
  "description": "批量查询 ASIN 在亚马逊搜索结果中的自然排名与广告排名（电脑端 + 移动端），行内展示关键词自然排名 TOP6 产品，支持一键导出 Excel。纯本地抓取，无需登录。",
  "version": "1.1.16",
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.ca/*",
    "https://www.amazon.com.br/*",
    "https://www.amazon.com.mx/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.de/*",
    "https://www.amazon.fr/*",
    "https://www.amazon.es/*",
    "https://www.amazon.it/*",
    "https://www.amazon.co.jp/*",
    "https://www.amazon.in/*",
    "https://www.amazon.com.au/*",
    "https://www.amazon.com.tr/*",
    "https://www.amazon.nl/*"
  ],
  "permissions": [
    "tabs",
    "cookies",
    "storage"
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "default_title": "亚马逊批量查排名"
  },
  "background": {
    "service_worker": "background.js"
  }
}
